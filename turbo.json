{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "outputs": ["packages/shared-types/database.types.ts"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY"
      ],
      "outputs": ["dist/**", ".next/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
